# Machine-to-machine (S2S) access on the "main" pool, as SaaS (infra platform/cognito-environment-api/tf/s2s.tf): OAuth resource
# servers with their scopes, and app clients that get access tokens for them with the client-credentials flow. With the api-gateway
# on Cognito (--saas-auth) a script calls POST https://api.<domain>/auth/token with such a client; the gateway passes it to the pool.
#
# Each client's id and secret go to Secrets Manager "<cluster>/cognito/s2s/<key>" (JSON client_id / client_secret), encrypted with the
# secrets key. The secret is generated by Cognito, so it is also in this state (aws_cognito_user_pool_client.client_secret).

resource "aws_cognito_resource_server" "this" {
  for_each = contains(keys(var.cognito_pools), "main") ? var.cognito_resource_servers : {}

  user_pool_id = aws_cognito_user_pool.this["main"].id
  identifier   = each.key
  name         = each.value.name

  dynamic "scope" {
    for_each = each.value.scopes
    content {
      scope_name        = scope.key
      scope_description = scope.value
    }
  }
}

resource "aws_cognito_user_pool_client" "s2s" {
  for_each = contains(keys(var.cognito_pools), "main") ? var.cognito_s2s_clients : {}

  name         = "${local.cognito_name["main"]}-s2s-${each.key}"
  user_pool_id = aws_cognito_user_pool.this["main"].id

  generate_secret     = true
  explicit_auth_flows = ["ALLOW_REFRESH_TOKEN_AUTH"]

  allowed_oauth_flows_user_pool_client = true
  allowed_oauth_flows                  = ["client_credentials"]
  allowed_oauth_scopes                 = each.value.scopes
  supported_identity_providers         = ["COGNITO"]
  enable_token_revocation              = true
  auth_session_validity                = 3

  access_token_validity = each.value.access_token_validity_minutes
  id_token_validity     = each.value.access_token_validity_minutes
  token_validity_units {
    access_token  = "minutes"
    id_token      = "minutes"
    refresh_token = "days"
  }

  # A scope must exist on its resource server before a client may be given it.
  depends_on = [aws_cognito_resource_server.this]
}

resource "aws_secretsmanager_secret" "s2s_client" {
  for_each = aws_cognito_user_pool_client.s2s

  name                    = "${local.name}/cognito/s2s/${each.key}"
  description             = "Cognito S2S app client ${each.key} of ${local.name} (client credentials; scopes ${join(" ", var.cognito_s2s_clients[each.key].scopes)}): JSON client_id / client_secret"
  kms_key_id              = local.secrets_kms_key_arn
  recovery_window_in_days = 7
  tags                    = merge(local.common_tags, { Name = "${local.name}/cognito/s2s/${each.key}" })
}

resource "aws_secretsmanager_secret_version" "s2s_client" {
  for_each = aws_cognito_user_pool_client.s2s

  secret_id = aws_secretsmanager_secret.s2s_client[each.key].id
  secret_string = jsonencode({
    client_id     = each.value.id
    client_secret = each.value.client_secret
    token_url     = "https://${aws_cognito_user_pool_domain.this["main"].domain}.auth.${var.region}.amazoncognito.com/oauth2/token"
  })
}
